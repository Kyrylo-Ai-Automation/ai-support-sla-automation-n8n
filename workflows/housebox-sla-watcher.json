    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst now = Date.now();\n\nconst truthy = value => ['true', 'yes', '1'].includes(String(value ?? '').trim().toLowerCase());\n// Закриті / виконані / скасовані звернення SLA-перевіркою не обробляються (префіксна перевірка: closed, закрито, закрыт, закрит, решено, вирішено, опрацьовано, обработано ...)\nconst closedStatusPattern = /^(clos|resolv|done|complet|finish|cancel|solv|закр|вирішен|решен|решён|розв|опрацьован|обработан|виконан|выполнен|скасован|отмен|завершен|завершён)/i;\nconst isClosedStatus = value => closedStatusPattern.test(String(value ?? '').trim());\n\nreturn rows\n  .filter(item => {\n    const r = item.json;\n    const slaText = String(r.sla_minutes ?? '').trim();\n    const sla = Number(slaText);\n    const created = new Date(r.date).getTime();\n    const category = String(r.category ?? '').trim().toLowerCase();\n\n    return String(r.email_id ?? '').trim() !== ''\n      && String(r.owner ?? '').trim() !== ''\n      && slaText !== ''\n      && Number.isFinite(sla) && sla > 0\n      && Number.isFinite(created)\n      && category !== 'spam'\n      && !isClosedStatus(r.status)\n      && !truthy(r.resolved)\n      && !truthy(r.processed);\n  })\n  .map(item => {\n    const r = item.json;\n    const deadline = new Date(r.date).getTime() + Number(r.sla_minutes) * 60000;\n    const overdue = now - deadline;\n    const level = String(r.escalation_level ?? '').trim().toUpperCase();\n    const l2Notified = truthy(r.escalation_notified);\n    let action = 'none';\n\n    if (overdue >= 0) {\n      if (!level && !truthy(r.sla_notified)) action = 'L0';\n      else if (level === 'L0' && overdue >= 30 * 60000) action = 'L1';\n      else if (level === 'L1' && overdue >= 90 * 60000 && !l2Notified) action = 'L2';\n    }\n\n    return {\n      json: {\n        ...r,\n        email_id: String(r.email_id).trim(),\n        should_notify_l0: action === 'L0',\n        should_notify_l1: action === 'L1',\n        should_notify_l2: action === 'L2',\n        next_escalation_action: action,\n        sla_deadline: new Date(deadline).toISOString(),\n        sla_overdue: overdue >= 0,\n        minutes_overdue: Math.max(0, Math.floor(overdue / 60000)),\n        checked_at: new Date(now).toISOString(),\n      },\n      pairedItem: item.pairedItem ?? { item: rows.indexOf(item) },\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
